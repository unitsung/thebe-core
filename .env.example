# DeepSeek Harness is the default AgentRuntime. Set THEBE_RUNTIME=pi only for
# the Pi compatibility runtime and its existing provider configuration.
# THEBE_RUNTIME=dsh
# DEEPSEEK_API_KEY=
# THEBE_DSH_PROVIDER=deepseek-official
# THEBE_DSH_MODEL=deepseek-flash

ARCANE_BASE_URL=http://127.0.0.1:3552
ARCANE_API_KEY=
# ARCANE_ENVIRONMENT_ID=0                  # Arcane environment the agent targets; 0 is Arcane's local one.
# Arcane activities (image pulls, updates, scans) also feed the product Activity feed.
# Alternative container provider with no Arcane: the Docker Engine API through a
# restricted docker-socket-proxy. Arcane wins when both are configured.
# THEBE_DOCKER_PROXY_URL=http://127.0.0.1:2375
# THEBE_DOCKER_API_VERSION=v1.43
NAVIDROME_BASE_URL=http://127.0.0.1:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# Optional composable service APIs: discovery, reads and approval-gated writes.
# Credentials stay in adapters; configure these separately from any client's own connections.
# THEBE_OPENLIST_BASE_URL=http://192.168.1.10:5244
# THEBE_OPENLIST_TOKEN=
# THEBE_CLOUDSAVER_BASE_URL=http://192.168.1.10:8008
# THEBE_CLOUDSAVER_TOKEN=
# Generic API connections: arbitrary service IDs; operations load from OpenAPI.
# Header values are environment references, never sent to the model.
# THEBE_SERVICE_APIS=[{"id":"my-service","baseURL":"http://192.168.1.10:8080","openapiPath":"/openapi.json","headersEnv":{"X-API-Key":"MY_SERVICE_API_KEY"}}]
# MY_SERVICE_API_KEY=
# NAVIDROME_FALLBACK_URL=https://music.example.com
# Navidrome capabilities appear only when URL, username, and password are all set.
# Optional qBittorrent native task inventory and completed-output Artifacts.
# Enabled only when all three values are set; supports Web API v4/v5.
# THEBE_QBITTORRENT_URL=http://127.0.0.1:8080
# THEBE_QBITTORRENT_USERNAME=
# THEBE_QBITTORRENT_PASSWORD=
# Optional aria2 download engine over JSON-RPC. Direct http(s), ftp and sftp links go to it; magnets and
# .torrent files stay on qBittorrent. The secret is aria2's rpc-secret and may be left empty.
# THEBE_ARIA2_URL=http://127.0.0.1:6800
# THEBE_ARIA2_SECRET=
# THEBE_HOST=0.0.0.0
# THEBE_PORT=8787
# THEBE_TOKEN=
# THEBE_ALLOWED_HOSTS=192.168.1.10,thebe-core.local
#
# Optional OAuth for claude.ai / ChatGPT connectors. OAuth is off when the
# issuer is unset. The issuer and resource need trusted HTTPS outside localhost;
# the resource path must be /mcp. Pre-register clients in
# $THEBE_CONFIG_DIR/oauth-clients.json (see docs/configuration.en.md).
# THEBE_OAUTH_ISSUER=https://thebe.example.com
# THEBE_MCP_RESOURCE_URL=https://thebe.example.com/mcp
# THEBE_OAUTH_CLIENTS_FILE=oauth-clients.json
# THEBE_OAUTH_DYNAMIC_REGISTRATION=false
# THEBE_OAUTH_REGISTRATION_TOKEN=
# THEBE_OAUTH_PAIRING_TTL_SECONDS=300
#
# Production (docs/DEPLOYMENT.md): NODE_ENV=production refuses to start without
# a token, and a 0.0.0.0 bind requires THEBE_ALLOWED_HOSTS.
# NODE_ENV=production
# THEBE_TOKEN=                             # openssl rand -hex 32
# THEBE_WORKSPACE_DIR=/srv/thebe-workspace
# THEBE_CONFIG_DIR=/var/lib/thebe/config
# THEBE_AGENT_DIR=/var/lib/thebe/agent
# THEBE_AGENT_STORE_DIR=/var/lib/thebe/store

# Optional web search (a SearXNG instance with JSON output) and music sources.
# THEBE_WEB_SEARCH_URL=http://127.0.0.1:8080
# THEBE_NETEASE_API_URL=http://127.0.0.1:3000
# THEBE_SQMUSIC_URL=http://127.0.0.1:8081
# THEBE_SQMUSIC_USERNAME=
# THEBE_SQMUSIC_PASSWORD=
# Let an agent connected over /mcp call write tools (restart a container, edit a playlist).
# On by default. Core does not ask first; the calling agent and its client do.
# Set off to make /mcp read-only.
# THEBE_MCP_WRITES=off
#
# Optional notification adapters. Prefer the owner-only
# ~/.thebe/notification-config.json, edited in the TUI with /notifications; the
# values below are a fallback for containers and automation. Address fields
# (topic, chat id, recipient, webhook URL) belong to each target in Core's
# owner-only notification settings, not to this file.
# THEBE_TELEGRAM_BOT_TOKEN=
# Two-way IM channels (also usable as notification targets).
# QQ official Bot OpenAPI v2: AppID/AppSecret become an environment-owned
# two-way channel. Passive replies only; no proactive push.
# THEBE_QQ_APP_ID=
# THEBE_QQ_APP_SECRET=
# Weixin ClawBot is added with QR login from the App; this optional base points the
# adapter at a self-hosted iLink proxy or a test double.
# THEBE_WECHAT_API_BASE=https://ilinkai.weixin.qq.com
# iMessage through a BlueBubbles server on an always-on Mac. The same
# THEBE_BLUEBUBBLES_* values also serve the notification target.
# THEBE_IMESSAGE_BASE_URL=
# THEBE_IMESSAGE_PASSWORD=
# THEBE_FEISHU_WEBHOOK_URL=
# THEBE_FEISHU_WEBHOOK_SECRET=
# THEBE_GOTIFY_URL=
# THEBE_PUSHOVER_TOKEN=
# THEBE_MATRIX_HOMESERVER_URL=
# THEBE_MATRIX_ACCESS_TOKEN=
# THEBE_SIGNAL_URL=
# THEBE_SIGNAL_NUMBER=
# THEBE_WHATSAPP_ACCESS_TOKEN=
# THEBE_WHATSAPP_PHONE_NUMBER_ID=
# THEBE_WHATSAPP_API_VERSION=v20.0
# THEBE_TWILIO_ACCOUNT_SID=
# THEBE_TWILIO_AUTH_TOKEN=
# THEBE_TWILIO_FROM=
# THEBE_BLUEBUBBLES_URL=
# THEBE_BLUEBUBBLES_PASSWORD=
# THEBE_APPRISE_URL=
# THEBE_APPRISE_KEY=
# LINE Messaging API push. The target supplies the recipient id.
# THEBE_LINE_CHANNEL_ACCESS_TOKEN=
# Zalo Bot API. THEBE_ZALO_API_URL is optional (proxy or test double).
# THEBE_ZALO_BOT_TOKEN=
# THEBE_ZALO_API_URL=https://bot-api.zaloplatforms.com
# Nextcloud Talk response bot. The target supplies the room token.
# THEBE_NEXTCLOUD_TALK_URL=
# THEBE_NEXTCLOUD_TALK_BOT_SECRET=
# Twitch Helix chat messages. The target supplies the broadcaster id.
# THEBE_TWITCH_CLIENT_ID=
# THEBE_TWITCH_USER_ACCESS_TOKEN=
# THEBE_TWITCH_SENDER_ID=
# IRC one-shot delivery. TLS defaults on for port 6697; set false for 6667.
# THEBE_IRC_HOST=
# THEBE_IRC_PORT=6697
# THEBE_IRC_TLS=true
# THEBE_IRC_NICK=
# THEBE_IRC_PASSWORD=
# The audit log defaults to <agent store>/audit.jsonl; override with THEBE_AUDIT_PATH.
