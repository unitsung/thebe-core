ARCANE_BASE_URL=http://127.0.0.1:3552
ARCANE_API_KEY=
# ARCANE_ENVIRONMENT_ID=0                  # Arcane environment the agent targets; 0 is Arcane's local one.
# Arcane activities (image pulls, updates, scans) also feed the product Activity feed.
NAVIDROME_BASE_URL=http://127.0.0.1:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# Optional composable service APIs: discovery, reads and approval-gated writes.
# Credentials stay in adapters; configure these separately from App connections.
# THEBE_OPENLIST_BASE_URL=http://192.168.1.10:5244
# THEBE_OPENLIST_TOKEN=
# THEBE_CLOUDSAVER_BASE_URL=http://192.168.1.10:8008
# THEBE_CLOUDSAVER_TOKEN=
# Generic API connections: arbitrary service IDs; operations load from OpenAPI.
# Header values are environment references, never sent to the model.
# THEBE_SERVICE_APIS=[{"id":"my-service","baseURL":"http://192.168.1.10:8080","openapiPath":"/openapi.json","headersEnv":{"X-API-Key":"MY_SERVICE_API_KEY"}}]
# MY_SERVICE_API_KEY=
# NAVIDROME_FALLBACK_URL=https://music.example.com
# Navidrome capabilities appear only when URL, username, and password are all set.
# Optional qBittorrent native task inventory and completed-output Artifacts.
# Enabled only when all three values are set; supports Web API v4/v5.
# THEBE_QBITTORRENT_URL=http://127.0.0.1:8080
# THEBE_QBITTORRENT_USERNAME=
# THEBE_QBITTORRENT_PASSWORD=
OPENCODE_API_KEY=
# THEBE_HOST=0.0.0.0
# THEBE_PORT=8787
# THEBE_TOKEN=
# THEBE_ALLOWED_HOSTS=192.168.1.10,thebe-core.local
#
# Production (docs/DEPLOYMENT.md): NODE_ENV=production refuses to start without
# a token, and a 0.0.0.0 bind requires THEBE_ALLOWED_HOSTS.
# NODE_ENV=production
# THEBE_TOKEN=                             # openssl rand -hex 32
# THEBE_WORKSPACE_DIR=/srv/thebe-workspace
# THEBE_CONFIG_DIR=/var/lib/thebe/config
# THEBE_AGENT_DIR=/var/lib/thebe/agent
# THEBE_AGENT_STORE_DIR=/var/lib/thebe/store
