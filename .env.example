# THEBE_WORKSPACE_DIR=/srv/thebe-workspace
# THEBE_CONFIG_DIR=/var/lib/thebe/config
# THEBE_AGENT_DIR=/var/lib/thebe/agent
# THEBE_AGENT_STORE_DIR=/var/lib/thebe/store
