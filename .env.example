ARCANE_BASE_URL=http://127.0.0.1:3552
ARCANE_API_KEY=
# ARCANE_ENVIRONMENT_ID=0                  # Arcane environment the agent targets; 0 is Arcane's local one.
# Arcane activities (image pulls, updates, scans) also feed the product Activity feed.
OPENCODE_API_KEY=
# THEBE_HOST=0.0.0.0
# THEBE_PORT=8787
# THEBE_TOKEN=
# THEBE_ALLOWED_HOSTS=192.168.1.10,thebe-core.local
#
# Production (docs/DEPLOYMENT.md): NODE_ENV=production refuses to start without
# a token, and a 0.0.0.0 bind requires THEBE_ALLOWED_HOSTS.
# NODE_ENV=production
# THEBE_TOKEN=                             # openssl rand -hex 32
# THEBE_WORKSPACE_DIR=/srv/thebe-workspace
# THEBE_CONFIG_DIR=/var/lib/thebe/config
# THEBE_AGENT_DIR=/var/lib/thebe/agent
# THEBE_AGENT_STORE_DIR=/var/lib/thebe/store
