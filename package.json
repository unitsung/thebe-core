{
  "name": "thebe-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless homelab agent on a replaceable coding-agent runtime.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.25.0",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "vite build",
    "start": "node dist/serve.js",
    "tui": "vite build && node dist/tui.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cli": "vite build && node dist/cli.js"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@types/node": "^22.20.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-server": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "chalk": "6.0.0"
  },
  "bin": {
    "thebe": "./dist/cli.js"
  }
}
