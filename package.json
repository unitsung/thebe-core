{
  "name": "thebe-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless homelab agent on a replaceable coding-agent runtime.",
  "license": "Apache-2.0",
  "scarfSettings": {
    "enabled": false
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "vite build",
    "start": "node dist/serve.js",
    "start:build": "npm run build && node dist/serve.js",
    "start:lan": "node scripts/start-lan.mjs",
    "start:lan:build": "npm run build && node scripts/start-lan.mjs",
    "docs": "npm start",
    "tui": "vite build && node dist/tui.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cli": "vite build && node dist/cli.js",
    "smoke": "node scripts/smoke.mjs",
    "release-check": "bash scripts/release-check.sh"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@earendil-works/pi-ai": "1.0.4",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-server": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@modelcontextprotocol/sdk": "1.31.0",
    "chalk": "6.0.0",
    "swagger-ui-dist": "5.32.15"
  },
  "bin": {
    "thebe": "./dist/cli.js"
  },
  "optionalDependencies": {
    "@earendil-works/gondolin": "0.12.0"
  }
}
