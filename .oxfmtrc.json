{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": false,
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "always",
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "out",
    "coverage",
    "*.tsbuildinfo",
    "data",
    "deploy/data",
    "deploy/workspace",
    "sessions",
    ".thebe",
    "package-lock.json",
    "*.log"
  ]
}
