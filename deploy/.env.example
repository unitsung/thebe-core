# Copy to deploy/.env and fill in. Never commit deploy/.env.
#
# Shared token every client (iOS App, curl, scripts) sends as X-Thebe-Token.
# Generate one with:  openssl rand -hex 32
THEBE_TOKEN=

# Host names / IPs allowed in the Host header of mutating requests. Required
# because the container binds 0.0.0.0 (the resolver only trusts loopback plus
# this list). Include the Tailscale name and the LAN address you actually use:
#   THEBE_ALLOWED_HOSTS=thebe.example.ts.net,192.168.1.10
THEBE_ALLOWED_HOSTS=

# Host folder mounted at /workspace: the only tree the agent may touch.
# Point this at the project or share you want the agent to operate on.
THEBE_WORKSPACE=./workspace
