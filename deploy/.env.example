# Copy to deploy/.env and fill in. Every value below is optional: the defaults
# are safe for a local/self-hosted run.
#
# Shared token every client (a client, curl, scripts) sends as X-Thebe-Token.
# Leave empty to have Core generate one on first start and print it once in the
# logs (`THEBE_TOKEN ...`); it is saved under the data dir and reused on restart.
# Set it here to pin your own value.
# THEBE_TOKEN=

# Extra host names / IPs allowed in the Host header of mutating requests.
# Loopback, private-network addresses, `.local`, and Tailscale `.ts.net` names
# are trusted automatically, so this is only needed for a public domain you
# reverse-proxy through:
#   THEBE_ALLOWED_HOSTS=thebe.example.com
# Use `*` to accept any Host (disables the DNS-rebinding Host check):
#   THEBE_ALLOWED_HOSTS=*
# THEBE_ALLOWED_HOSTS=

# Host folder mounted at /workspace: the only tree the agent may touch.
# Defaults to ./workspace next to this file. On Linux, make it writable by
# uid 1000 so the agent can write (see docs/DEPLOYMENT.md §1.2).
# THEBE_WORKSPACE=./workspace

# Optional: run the published image instead of building from source. The GHCR
# package is private while the repository is private, so log in first:
#   docker login ghcr.io          # paste a token with read:packages
#   docker compose pull && docker compose up -d
# Leave this unset to build locally (`docker compose up -d --build`).
# THEBE_IMAGE=ghcr.io/unitsung/thebe-core:latest

# Optional container provider without Arcane: the Docker Engine API through a
# restricted docker-socket-proxy (see docs/configuration.en.md). Arcane wins
# when both are configured. Only expose the read endpoints plus restart on the
# proxy, and keep it on loopback or Tailscale.
# THEBE_DOCKER_PROXY_URL=http://127.0.0.1:2375
# THEBE_DOCKER_API_VERSION=v1.43

# Optional Navidrome provider. Set all three values to expose music capabilities.
# NAVIDROME_BASE_URL=http://192.168.1.10:4533
# NAVIDROME_USERNAME=thebe
# NAVIDROME_PASSWORD=
# NAVIDROME_FALLBACK_URL=https://music.example.com

# Optional authenticated API composition (discover/read/write tools).
# THEBE_OPENLIST_BASE_URL=http://192.168.1.10:5244
# THEBE_OPENLIST_TOKEN=
# THEBE_CLOUDSAVER_BASE_URL=http://192.168.1.10:8008
# THEBE_CLOUDSAVER_TOKEN=
# Arbitrary service connections; no per-operation tool code is required.
# THEBE_SERVICE_APIS=[{"id":"my-service","baseURL":"http://192.168.1.10:8080","openapiPath":"/openapi.json","headersEnv":{"X-API-Key":"MY_SERVICE_API_KEY"}}]
# MY_SERVICE_API_KEY=

# Let an agent connected over /mcp call write tools (restart a container, edit a playlist).
# On by default. Core does not ask first; the calling agent and its client do.
# Set off to make /mcp read-only.
# THEBE_MCP_WRITES=off

# Home network mode: publish Core on this host's LAN address instead of loopback only. The token then
# travels in plaintext on your network, so keep THEBE_REMOTE_BASH off, and consider THEBE_MCP_WRITES=off, unless you trust that network.
# THEBE_BIND=192.168.1.10

# Gateway for an agent on the internet (Claude Code, Claude API, a self-hosted agent): a second port that
# serves /mcp plus the OAuth endpoints when OAuth is enabled. Expose this port, never 8787, through a tunnel
# or reverse proxy, and give a bearer-token agent its own scoped token. Loopback unless THEBE_MCP_BIND says so.
# THEBE_MCP_PORT=8788
# THEBE_MCP_BIND=127.0.0.1
# THEBE_MCP_RATE_LIMIT=120

# Optional OAuth for claude.ai / ChatGPT connectors. Keep the gateway behind a
# trusted HTTPS proxy and use the exact public origin the connector reaches.
# Core reads clients from $THEBE_CONFIG_DIR/oauth-clients.json (in the container,
# /data/config/oauth-clients.json) unless THEBE_OAUTH_CLIENTS_FILE or inline
# THEBE_OAUTH_CLIENTS is set. The resource must be the public URL ending in /mcp.
# See docs/configuration.en.md ("MCP OAuth gateway") for the client JSON.
# THEBE_OAUTH_ISSUER=https://thebe.example.com
# THEBE_MCP_RESOURCE_URL=https://thebe.example.com/mcp
# THEBE_OAUTH_CLIENTS_FILE=oauth-clients.json
# Dynamic registration is off unless explicitly enabled. If enabled, set a
# registration token so /oauth/register requires it as an initial access token.
# THEBE_OAUTH_DYNAMIC_REGISTRATION=false
# THEBE_OAUTH_REGISTRATION_TOKEN=
# THEBE_OAUTH_PAIRING_TTL_SECONDS=300

# Optional web search (a SearXNG instance with JSON output) and music sources.
# THEBE_WEB_SEARCH_URL=http://127.0.0.1:8080
# THEBE_NETEASE_API_URL=http://127.0.0.1:3000
# THEBE_SQMUSIC_URL=http://127.0.0.1:8081
# THEBE_SQMUSIC_USERNAME=
# THEBE_SQMUSIC_PASSWORD=
# The audit log defaults to <agent store>/audit.jsonl; override with THEBE_AUDIT_PATH.

# Sources Core watches in the background (comma list). Off when unset. Today: container-health, which records
# a Trigger when a container changes state. It only records them; nothing acts on them yet.
# THEBE_SOURCES=container-health
# THEBE_SOURCE_INTERVAL_MS=30000
# How many times an hour Eval may ask the model (default 60; 0 is no limit). A circuit breaker for a noisy
# Source such as a container that keeps restarting, not a budget. Past it, Decisions are recorded as
# unavailable (assessment_limit) rather than as a "no".
# THEBE_EVAL_MAX_PER_HOUR=60
